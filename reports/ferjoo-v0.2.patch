+
+function reportToNdjson(report) {
+  const lines = [];
+  lines.push(
+    JSON.stringify({
+      type: 'metadata',
+      schema: report.schema,
+      generatedAt: report.generatedAt,
+      engine: report.engine,
+      equivalenceDefinition: report.equivalenceDefinition,
+      axes: report.axes
