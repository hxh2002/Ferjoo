# Supabase 项目配置（复制为 .env 后填入实际值）
# 在 Supabase Dashboard → Project Settings → API 中获取
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Only the public VAPID key is exposed to the browser. Keep the private key in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# 首位管理员不在这里配置，也不要写入密码。
# 在 Supabase SQL Editor 中提升第一个管理员后，若当时还没有首位管理员，该账号会自动成为首位管理员：
#   select private.set_user_role('<auth.users.id>', 'A');
# 转移首位管理员（仅数据库管理员）：
#   select private.designate_super_admin('email@example.com');
